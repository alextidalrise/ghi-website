SANITY_STUDIO_PROJECT_ID=s88o8sjb

# Default CLI dataset (Studio uses workspace switcher: production at /, development at /development)
SANITY_STUDIO_DATASET=production

# Frontend origin for Presentation tool preview (local dev or Vercel preview URL)
SANITY_STUDIO_PREVIEW_ORIGIN=http://localhost:5173

# Write token (Editor role+). USE THIS FOR ALL CONTENT WORK: seeding fixtures, migrations,
# and — importantly — ANY read or patch of DRAFT documents (drafts.<id>). Scripts should
# prefer it: `process.env.SANITY_API_TOKEN ?? process.env.SANITY_AUTH_TOKEN`.
# SANITY_API_TOKEN=

# Deploy token for headless CLI (`sanity deploy`) — reserved name the CLI reads automatically.
# Role is deploy-studio: it can read PUBLISHED docs but is BLIND TO DRAFTS, and does so
# SILENTLY — a draft read returns empty, so a real draft-only doc looks like it doesn't exist.
# Never default to this for content reads/writes. Copy to .env.local — never commit.
# SANITY_AUTH_TOKEN=
