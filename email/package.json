{
	"name": "email",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"description": "Golf Homes International HTML email foundation: Maizzle build, brand tokens, locale system, validator and QA harness.",
	"scripts": {
		"dev": "maizzle serve",
		"build": "maizzle build production && node bin/plaintext.mjs",
		"build:local": "maizzle build",
		"assets": "node bin/build-assets.mjs",
		"assets:social": "node bin/generate-social-icons.mjs",
		"validate": "node bin/validate.mjs",
		"validate:links": "node bin/validate.mjs --links",
		"validate:self-test": "node bin/validate-self-test.mjs",
		"validate:components": "node bin/component-library-self-test.mjs",
		"validate:template": "node bin/validate-template.mjs",
		"plaintext": "node bin/plaintext.mjs",
		"qa": "node bin/qa-screens.mjs",
		"qa:long": "node bin/qa-long-email.mjs",
		"qa:path-self-test": "node bin/qa-path-self-test.mjs",
		"check": "pnpm validate:self-test && pnpm qa:path-self-test && pnpm build && pnpm validate:components && pnpm validate && node bin/plaintext.mjs --check && pnpm qa"
	},
	"devDependencies": {
		"@maizzle/framework": "^5.5.0",
		"playwright": "^1.61.1",
		"sharp": "^0.35.3"
	}
}
